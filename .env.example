# Plantilla de configuración: copia este archivo a .env y rellena los valores.
# Nunca subas .env al repositorio. Aquí solo van los nombres de las variables.

# Conexión a PostgreSQL (con la extensión pgvector)
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Ruta al certificado CA si la BBDD exige SSL (vacío si no hace falta)
DB_SSL_CA=
